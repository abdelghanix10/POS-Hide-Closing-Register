<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_hide_closing" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.hide.closing</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Closing &amp; Inventory" name="closing_inventory_section">
                    <field name="hide_closing_register"/>
                    <field name="enable_inventory_adjustment" invisible="not hide_closing_register"/>
                    <field name="inventory_adjustment_product_ids" widget="many2many_tags" invisible="not enable_inventory_adjustment"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
