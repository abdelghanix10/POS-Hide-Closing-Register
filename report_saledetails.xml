<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_saledetails">
            <style>
                body {
                    margin: 0;
                    padding: 0;
                    font-weight: bold;
                }
                @media print {
                    body {
                        font-size: 16px;
                        max-width: 80mm;
                    }
                }
                @media screen {
                    body {
                        font-size: 18px;
                    }
                }
                table {
                    table-layout: fixed;
                    width: 100%;
                }
                td, th {
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                    white-space: normal;
                }
                th:first-child, td:first-child {
                    width: 50%;
                }
                th:nth-child(2), td:nth-child(2) {
                    width: 15%;
                    text-align: right;
                }
                th:nth-child(3), td:nth-child(3) {
                    width: 35%;
                    text-align: center;
                }
            </style>
            <main>
                <t t-foreach="docs" t-as="o">
                    <div class="page" style="width: 80mm; font-size: 16px; font-family: monospace; padding: 5px; font-weight: bold;">
                        <div style="text-align: center; margin-bottom: 10px;">
                            <img t-attf-src="/web/image/res.company/{{o.company_id.id}}/logo" style="max-width: 50mm; max-height: 20mm;"/><br/>
                            <strong><t t-esc="o.company_id.name"/></strong><br/>
                            <small><t t-esc="o.company_id.street or ''"/>, <t t-esc="o.company_id.city or ''"/>, <t t-esc="o.company_id.country_id.name if o.company_id.country_id else ''"/></small><br/>
                            <small>Phone: <t t-esc="o.company_id.phone or ''"/></small><br/>
                        </div>
                        <div style="text-align: center; margin-bottom: 10px; border-bottom: 1px solid #000; padding-bottom: 5px;">
                            <strong>SESSION REPORT</strong>
                        </div>
                        <div style="margin-bottom: 10px;">
                            <strong>Session ID:</strong> <t t-esc="o.name"/><br/>
                            <strong>Opened:</strong> <t t-esc="o.start_at"/><br/>
                            <strong>Closed:</strong> <t t-esc="o.stop_at"/><br/>
                            <strong>Status:</strong> <t t-esc="o.state"/><br/>
                        </div>
                        <hr style="border: none; border-top: 1px dashed #000; margin: 10px 0;"/>
                        <div style="margin-bottom: 10px;">
                            <strong>Opening Balance:</strong> <t t-esc="'{:.2f}'.format(o.cash_register_balance_start)"/> DH<br/>
                            <strong>Closing Balance:</strong> <t t-esc="'{:.2f}'.format(o.cash_register_balance_end_real)"/> DH<br/>
                            <strong>Difference:</strong> <t t-esc="'{:.2f}'.format(o.cash_register_difference)"/> DH<br/>
                        </div>
                        <hr style="border: none; border-top: 1px dashed #000; margin: 10px 0;"/>
                        <div style="margin-bottom: 10px;">
                            <strong>Gross Sales:</strong> <t t-esc="'{:.2f}'.format(sum(o.order_ids.mapped('amount_total')))"/> DH<br/>
                            <strong>Tax:</strong> <t t-esc="'{:.2f}'.format(sum(o.order_ids.mapped('amount_tax')))"/> DH<br/>
                            <strong>Returns:</strong> <t t-esc="'{:.2f}'.format(sum(o.order_ids.filtered(lambda x: x.amount_total &lt; 0).mapped('amount_total')))"/> DH<br/>
                            <strong>Cash In:</strong> <t t-esc="'{:.2f}'.format(o.cash_register_balance_end_real - o.cash_register_balance_start)"/> DH<br/>
                            <strong>Cash Out:</strong> <t t-esc="'{:.2f}'.format(0.0)"/> DH<br/>
                            <strong>Discount:</strong> <t t-esc="'{:.2f}'.format(sum(o.order_ids.mapped('lines').filtered(lambda l: l.discount).mapped(lambda l: l.price_unit * l.qty * l.discount / 100)))"/> DH<br/>
                            <strong>Total:</strong> <t t-esc="'{:.2f}'.format(sum(o.order_ids.mapped('amount_total')))"/> DH<br/>
                        </div>
                        
                        <hr style="border: none; border-top: 1px dashed #000; margin: 10px 0;"/>
                        <div style="margin-bottom: 10px;">
                            <strong>SALES BREAKDOWN</strong><br/>
                            <table style="width: 100%; font-size: 14px; border-collapse: collapse; font-weight: bold;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #000;">
                                        <th style="text-align: left;">Item</th>
                                        <th style="text-align: right; padding-right: 10px;">Qty</th>
                                        <th style="text-align: center;">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="order_lines" t-value="o.order_ids.mapped('lines').filtered(lambda l: l.product_id and l.product_id.product_tmpl_id.pos_categ_ids)"/>
                                    <t t-set="categories" t-value="order_lines.mapped(lambda l: l.product_id.product_tmpl_id.pos_categ_ids).sorted(key=lambda c: c.name)"/>
                                    <t t-foreach="categories" t-as="category">
                                        <t t-set="cat_lines" t-value="order_lines.filtered(lambda l: category in l.product_id.product_tmpl_id.pos_categ_ids)"/>
                                        <t t-set="cat_qty" t-value="sum(cat_lines.mapped('qty'))"/>
                                        <t t-set="cat_amount" t-value="sum(cat_lines.mapped('price_subtotal_incl'))"/>
                                        <tr>
                                            <td colspan="3" style="height: 10px;"></td>
                                        </tr>
                                        <tr style="border-top: 1px solid #000; font-size: 15px;">
                                            <td style="padding-top: 10px;"><strong><t t-esc="category.name"/></strong></td>
                                            <td style="text-align: right; padding-right: 10px; padding-top: 10px;"><strong><t t-esc="'{:.1f}'.format(cat_qty)"/></strong></td>
                                            <td style="text-align: center; padding-top: 10px;"><strong><t t-esc="'{:.2f}'.format(cat_amount)"/> DH</strong></td>
                                        </tr>
                                        <t t-set="products" t-value="cat_lines.mapped('product_id').sorted(key=lambda p: p.name)"/>
                                        <t t-foreach="products" t-as="product">
                                            <t t-set="prod_lines" t-value="cat_lines.filtered(lambda l: l.product_id == product)"/>
                                            <t t-set="prod_qty" t-value="sum(prod_lines.mapped('qty'))"/>
                                            <t t-set="prod_amount" t-value="sum(prod_lines.mapped('price_subtotal_incl'))"/>
                                            <tr>
                                                <td colspan="3"><hr style="border: none; border-top: 1px dashed #000; margin: 5px 0;"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding-left: 10px;"><t t-esc="product.name"/></td>
                                                <td style="text-align: right; padding-right: 10px;"><t t-esc="'{:.1f}'.format(prod_qty)"/></td>
                                                <td style="text-align: center;"><t t-esc="'{:.2f}'.format(prod_amount)"/> DH</td>
                                            </tr>
                                        </t>
                                    </t>
                                    <tr>
                                        <td colspan="3" style="height: 10px;"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        
                        <hr style="border: none; border-top: 1px dashed #000; margin: 10px 0;"/>
                        <div style="margin-bottom: 10px;">
                            <strong>PAYMENTS</strong><br/>
                            <t t-set="payments" t-value="o.order_ids.mapped('payment_ids')"/>
                            <t t-set="payment_methods" t-value="payments.mapped('payment_method_id').sorted(key=lambda m: m.name)"/>
                            <t t-foreach="payment_methods" t-as="method">
                                <t t-set="method_payments" t-value="payments.filtered(lambda p: p.payment_method_id == method)"/>
                                <t t-esc="method.name"/>: <t t-esc="'{:.2f}'.format(sum(method_payments.mapped('amount')))"/> DH<br/>
                            </t>
                        </div>
                        <hr style="border: none; border-top: 1px dashed #000; margin: 10px 0;"/>
                        <div style="text-align: center; margin-bottom: 10px;">
                            <strong>TOTAL SALES: <t t-esc="'{:.2f}'.format(sum(o.order_ids.mapped('amount_total')))"/> DH</strong>
                        </div>
                        <hr style="border: none; border-top: 1px dashed #000; margin: 10px 0;"/>
                        <div style="text-align: center; margin-top: 10px;">
                            <strong>Thank you for using Odoo POS</strong><br/>
                            <small>Generated on <t t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/></small>
                        </div>
                    </div>
                </t>
            </main>
        </template>

        <record id="sale_details_report" model="ir.actions.report">
            <field name="name">Sales Details</field>
            <field name="model">pos.session</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">pos_hide_closing_register.report_saledetails</field>
            <field name="report_file">pos_hide_closing_register.report_saledetails</field>
            <field name="print_report_name">'Sales Details - %s' % (object.name)</field>
            <field name="binding_model_id" ref="point_of_sale.model_pos_session"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
